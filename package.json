{
  "name": "orpheia-ctc-lab",
  "productName": "ORPHEIA CTC LAB",
  "version": "0.25.3",
  "description": "오르페이아 철도관제 LS·MMI 데스크톱 실습",
  "private": true,
  "author": "CTC LAB",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test desktop/*.test.cjs simulator/engine/*.test.cjs simulator/ui/*.test.cjs",
    "test:desktop": "node desktop/smoke.cjs && node desktop/engine-smoke.cjs && node desktop/ls-windows-smoke.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist:mac": "electron-builder --mac --arm64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "setup:electron": "node desktop/install-electron.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "org.orpheia.ctclab",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "desktop/resources"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/window-state.cjs",
      "desktop/resources/**",
      "simulator/**",
      "!simulator/**/*.test.*",
      "!simulator/e2e/**",
      "!simulator/engine/route-conflict-audit.cjs",
      "package.json",
      "!simulator/**/*.md",
      "desktop/engine-process.cjs",
      "desktop/engine-broker.cjs",
      "desktop/preload.cjs",
      "desktop/session-store.cjs"
    ],
    "artifactName": "ORPHEIA-CTC-LAB-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "desktop/resources/icon.png",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "desktop/resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "dir",
      "icon": "desktop/resources/icon.png"
    }
  }
}
